    <script>
        const DEFAULT_CONFIG = {
            materials: {
                'nhua_sua': { name: 'Nhựa Sữa', sheet_tier1: 40000, sheet_tier2: 32000, cm_tier1: 16, cm_tier2: 15, cm_tier3: 14, cm_tier4: 12 },
                'pp': { name: 'Decal PP', sheet_tier1: 37000, sheet_tier2: 30000, cm_tier1: 15, cm_tier2: 14, cm_tier3: 13, cm_tier4: 12 },
                'trong': { name: 'Nhựa Trong', sheet_tier1: 37000, sheet_tier2: 30000, cm_tier1: 15, cm_tier2: 14, cm_tier3: 13, cm_tier4: 11 },
                'xi': { name: 'Xi Bạc', sheet_tier1: 50000, sheet_tier2: 40000, cm_tier1: 25, cm_tier2: 23, cm_tier3: 22, cm_tier4: 20 },
                'kraft': { name: 'Kraft Nâu', sheet_tier1: 35000, sheet_tier2: 25000, cm_tier1: 14, cm_tier2: 13, cm_tier3: 12, cm_tier4: 10 },
                'giay': { name: 'Decal Giấy', sheet_tier1: 35000, sheet_tier2: 25000, cm_tier1: 14, cm_tier2: 13, cm_tier3: 12, cm_tier4: 10 }
            },
            coating: { sheet_price: 3000, cm_price_normal: 2, cm_price_bulk: 1.5 },
            shapeSurcharges: {
                'circle':    { name: 'Tròn', add_cm2: 1 },
                'triangle':  { name: 'Tam giác', add_cm2: 1 },
                'eclipse':   { name: 'Eclipse', add_cm2: 1 },
                'rectangle': { name: 'Chữ nhật', add_cm2: 1 },
                'pentagon':  { name: 'Ngũ giác', add_cm2: 1 },
                'hexagon':   { name: 'Lục giác', add_cm2: 1 },
                'square':    { name: 'Vuông', add_cm2: 1 },
                'complex':   { name: 'Phức tạp', add_cm2: 2 }
            },
            sheetConfig: { w: 330, h: 350, bleed: 0 } 
        };

        let currentConfig = {};
        let currentQuoteResult = null; 

        function initApp() {
            let saved = localStorage.getItem('decalProConfigV11');
            if (saved) currentConfig = JSON.parse(saved);
            else currentConfig = JSON.parse(JSON.stringify(DEFAULT_CONFIG));

            updateUI();
            renderAdminInputs();
        }

        function formatMoney(amount) { return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(Math.round(amount)); }
        function setQty(val) { document.getElementById('quantity').value = val; calculate(); }
        
        function toggleCutline() { 
            const cutlines = document.querySelectorAll('.cutline');
            const show = document.getElementById('show-cutline').checked;
            cutlines.forEach(c => show ? c.classList.remove('hidden') : c.classList.add('hidden'));
        }

        function handleImageUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const imgEl = document.getElementById('preview-user-img');
                    imgEl.src = e.target.result;
                    imgEl.classList.remove('hidden');
                    document.getElementById('preview-icon-wrapper').classList.add('hidden');
                }
                reader.readAsDataURL(file);
            }
        }

        function updateUI() {
            const shape = document.querySelector('input[name="shape"]:checked').value;
            const hContainer = document.getElementById('height-container');
            const lWidth = document.getElementById('label-width');
            
            if (shape === 'square' || shape === 'circle' || shape === 'triangle' || shape === 'pentagon' || shape === 'hexagon') {
                hContainer.style.display = 'none';
                lWidth.innerHTML = (shape === 'circle') ? 'Đường kính <b>Ø</b> (mm)' : 'Kích thước (mm)';
            } else {
                hContainer.style.display = 'block';
                lWidth.innerText = 'Chiều Rộng (mm)';
            }
            updatePreviewStyle();
            calculate();
        }

        function updatePreviewStyle() {
            const shape = document.querySelector('input[name="shape"]:checked').value;
            const material = document.querySelector('input[name="material"]:checked').value;
            const preview = document.getElementById('preview-item');
            
            let w = parseFloat(document.getElementById('width').value) || 50;
            let h = (shape === 'rectangle' || shape === 'eclipse') ? (parseFloat(document.getElementById('height').value) || 50) : w;

            document.getElementById('preview-dim-w').innerText = `${w}mm`;
            document.getElementById('preview-dim-h').innerText = `${h}mm`;

            preview.className = `relative flex items-center justify-center transition-all duration-300 mx-auto shape-${shape} mat-${material}`;
            
            const icon = document.getElementById('preview-icon');
            if(material === 'kraft') icon.className = "fa-solid fa-leaf text-3xl mb-1 text-yellow-900 opacity-60";
            else if(material === 'xi') icon.className = "fa-solid fa-gem text-3xl mb-1 text-gray-700 opacity-70";
            else icon.className = "fa-solid fa-crown text-3xl mb-1 text-gray-400 opacity-50";

            let maxBox = 200, renderW, renderH;
            if (w > h) { renderW = maxBox; renderH = (h / w) * maxBox; } 
            else { renderH = maxBox; renderW = (w / h) * maxBox; }
            preview.style.width = `${renderW}px`; preview.style.height = `${renderH}px`;
        }

        function calculateLogic(w, h, qty, shapeKey, matKey, coatingKey, taxRate) {
            const sheet = currentConfig.sheetConfig;
            const matCfg = currentConfig.materials[matKey];
            const coatCfg = currentConfig.coating;
            const shapeAddCm2 = currentConfig.shapeSurcharges[shapeKey] ? currentConfig.shapeSurcharges[shapeKey].add_cm2 : 0;
            const shapeName = currentConfig.shapeSurcharges[shapeKey].name;
            const hasCoating = coatingKey !== 'none';
            
            let wBleed = w + sheet.bleed;
            let hBleed = h + sheet.bleed;

            if (wBleed > Math.max(sheet.w, sheet.h) || hBleed > Math.max(sheet.w, sheet.h)) {
                return { error: 'Kích thước vượt quá khổ giấy 32x34cm' };
            }

            let cols1 = Math.floor(sheet.w / wBleed);
            let rows1 = Math.floor(sheet.h / hBleed);
            let count1 = cols1 * rows1;
            let cols2 = Math.floor(sheet.w / hBleed);
            let rows2 = Math.floor(sheet.h / wBleed);
            let count2 = cols2 * rows2;

            let stickersPerSheet = Math.max(count1, count2);
            if (stickersPerSheet === 0) stickersPerSheet = 1;

            let area1TemCm2 = (wBleed / 10) * (hBleed / 10);
            let totalAreaCm2 = area1TemCm2 * qty;

            let basePrintTotal = 0; 
            let coatTotal = 0;
            let cutTotal = 0;

            let methodText = "";
            let coatCondText = "Không cán màng";
            let coatUnitText = "0đ";

            let sheetsNeeded = Math.ceil(qty / stickersPerSheet);

            if (qty < 1000) {
                if (totalAreaCm2 >= 1 && totalAreaCm2 <= 4351) {
                    basePrintTotal = sheetsNeeded * matCfg.sheet_tier1;
                    if(hasCoating) { 
                        coatTotal = sheetsNeeded * coatCfg.sheet_price; 
                        coatCondText = `Theo Tờ`;
                        coatUnitText = `${formatMoney(coatCfg.sheet_price)} / tờ`;
                    }
                    methodText = `Tính theo Tờ (Mốc 1)`;
                } 
                else if (totalAreaCm2 > 4351 && totalAreaCm2 <= 8704) {
                    basePrintTotal = sheetsNeeded * matCfg.sheet_tier2;
                    if(hasCoating) { 
                        coatTotal = sheetsNeeded * coatCfg.sheet_price; 
                        coatCondText = `Theo Tờ`;
                        coatUnitText = `${formatMoney(coatCfg.sheet_price)} / tờ`;
                    }
                    methodText = `Tính theo Tờ (Mốc 2)`;
                }
                else {
                    basePrintTotal = totalAreaCm2 * matCfg.cm_tier1;
                    if(hasCoating) { 
                        coatTotal = totalAreaCm2 * coatCfg.cm_price_normal; 
                        coatCondText = `Theo cm²`;
                        coatUnitText = `${coatCfg.cm_price_normal} đ/cm²`;
                    }
                    methodText = `Tính theo cm² (Do diện tích lớn)`;
                }
            } 
            else {
                let pricePerCm2 = 0;
                let coatingPerCm2 = 0;

                if (qty >= 1000 && qty < 2000) {
                    pricePerCm2 = matCfg.cm_tier1; coatingPerCm2 = coatCfg.cm_price_normal;
                    methodText = `Tính theo cm² (Mốc 1K-2K)`;
                } else if (qty >= 2000 && qty < 3000) {
                    pricePerCm2 = matCfg.cm_tier2; coatingPerCm2 = coatCfg.cm_price_normal;
                    methodText = `Tính theo cm² (Mốc 2K-3K)`;
                } else if (qty >= 3000 && qty < 5000) {
                    pricePerCm2 = matCfg.cm_tier3; coatingPerCm2 = coatCfg.cm_price_normal;
                    methodText = `Tính theo cm² (Mốc 3K-5K)`;
                } else {
                    pricePerCm2 = matCfg.cm_tier4; coatingPerCm2 = coatCfg.cm_price_bulk;
                    methodText = `Tính theo cm² (Mốc >= 5K)`;
                }

                basePrintTotal = totalAreaCm2 * pricePerCm2;
                if(hasCoating) {
                    coatTotal = totalAreaCm2 * coatingPerCm2;
                    coatCondText = `Theo cm²`;
                    coatUnitText = `${coatingPerCm2} đ/cm²`;
                }
            }

            if (shapeAddCm2 > 0) { cutTotal = totalAreaCm2 * shapeAddCm2; }

            let subTotal = basePrintTotal + coatTotal + cutTotal;
            let taxAmount = subTotal * taxRate;
            let finalPrice = subTotal + taxAmount;

            return {
                w: w, h: h, qty: qty, shapeName: shapeName, matName: matCfg.name,
                coatingName: coatingKey === 'none' ? 'Không' : 'Có cán màng',
                taxRateText: taxRate === 0 ? '0%' : (taxRate === 0.08 ? '8%' : '10%'),
                taxRateValue: taxRate,
                areaCm2: area1TemCm2, totalAreaCm2: totalAreaCm2, stickersPerSheet: stickersPerSheet, sheetsNeeded: sheetsNeeded,
                methodText: methodText, basePrintTotal: basePrintTotal, coatCondText: coatCondText, coatUnitText: coatUnitText,
                coatTotal: coatTotal, shapeAddCm2: shapeAddCm2, cutTotal: cutTotal,
                subTotal: subTotal, taxAmount: taxAmount, finalPrice: finalPrice, unitPrice: finalPrice / qty
            };
        }

        function calculate() {
            let shape = document.querySelector('input[name="shape"]:checked').value;
            let material = document.querySelector('input[name="material"]:checked').value;
            let qty = parseInt(document.getElementById('quantity').value) || 10;
            let coating = document.getElementById('coating').value;
            let taxRate = parseFloat(document.querySelector('input[name="tax"]:checked').value);

            let w = parseFloat(document.getElementById('width').value) || 50;
            let h = (shape === 'rectangle' || shape === 'eclipse') ? (parseFloat(document.getElementById('height').value) || 50) : w;

            let result = calculateLogic(w, h, qty, shape, material, coating, taxRate);

            if (result.error) {
                document.getElementById('final-price').innerText = "Quá khổ";
                document.getElementById('unit-price').innerText = "0đ";
                currentQuoteResult = null; return;
            }
            currentQuoteResult = result;

            // BINDING TRƯỜNG THÔNG SỐ (UI CHÍNH)
            // PHẦN IN
            document.getElementById('ui-info-mat').innerText = result.matName;
            document.getElementById('ui-info-total-area').innerText = result.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2}) + ' cm²';
            document.getElementById('ui-info-method').innerText = result.methodText;
            document.getElementById('ui-info-persheet').innerText = result.stickersPerSheet + ' tem';
            document.getElementById('ui-info-sheets').innerText = result.sheetsNeeded + ' tờ';
            document.getElementById('ui-info-print-total').innerText = formatMoney(result.basePrintTotal);

            // PHẦN CÁN MÀNG
            let coatAreaTxt = result.coatingName === 'Không' ? '0 cm²' : (result.coatCondText.includes('Tờ') ? `${result.sheetsNeeded} tờ` : `${result.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2})} cm²`);
            document.getElementById('ui-info-coat-area').innerText = coatAreaTxt;
            document.getElementById('ui-info-coat-cond').innerText = result.coatCondText;
            document.getElementById('ui-info-coat-unit').innerText = result.coatUnitText;
            document.getElementById('ui-info-coat-total').innerText = formatMoney(result.coatTotal);

            // PHẦN BẾ
            document.getElementById('ui-info-cut-area').innerText = result.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2}) + ' cm²';
            document.getElementById('ui-info-cut-shape').innerText = result.shapeName;
            document.getElementById('ui-info-cut-unit').innerText = result.shapeAddCm2 + ' đ/cm²';
            document.getElementById('ui-info-cut-total').innerText = formatMoney(result.cutTotal);

            // TỔNG TIỀN
            document.getElementById('sub-total').innerText = formatMoney(result.subTotal);
            if (taxRate > 0) {
                document.getElementById('tax-row').style.display = 'flex';
                document.getElementById('tax-amount').innerText = formatMoney(result.taxAmount);
            } else { document.getElementById('tax-row').style.display = 'none'; }
            document.getElementById('final-price').innerText = formatMoney(result.finalPrice);
            document.getElementById('unit-price').innerText = formatMoney(result.unitPrice);
        }

        function showInvoiceModal() {
            if (!currentQuoteResult) { alert("Lỗi thông số để tính giá."); return; }
            const r = currentQuoteResult;
            let dateStr = new Date().toLocaleDateString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric' });
            
            document.getElementById('inv-date').innerText = 'Ngày: ' + dateStr;
            document.getElementById('inv-basic-shape').innerText = r.shapeName;
            document.getElementById('inv-basic-size').innerText = `${r.w} x ${r.h} mm`;
            document.getElementById('inv-basic-mat').innerText = r.matName;
            document.getElementById('inv-basic-qty').innerText = r.qty.toLocaleString('vi-VN') + ' tem';

            // BINDING TRƯỜNG THÔNG SỐ (INVOICE MODAL)
            // PHẦN IN
            document.getElementById('inv-info-mat').innerText = r.matName;
            document.getElementById('inv-info-total-area').innerText = r.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2}) + ' cm²';
            document.getElementById('inv-info-method').innerText = r.methodText;
            document.getElementById('inv-info-persheet').innerText = r.stickersPerSheet + ' tem';
            document.getElementById('inv-info-sheets').innerText = r.sheetsNeeded + ' tờ';
            document.getElementById('inv-info-print-total').innerText = formatMoney(r.basePrintTotal);

            // PHẦN CÁN MÀNG
            let coatAreaTxt = r.coatingName === 'Không' ? '0 cm²' : (r.coatCondText.includes('Tờ') ? `${r.sheetsNeeded} tờ` : `${r.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2})} cm²`);
            document.getElementById('inv-info-coat-area').innerText = coatAreaTxt;
            document.getElementById('inv-info-coat-cond').innerText = r.coatCondText;
            document.getElementById('inv-info-coat-unit').innerText = r.coatUnitText;
            document.getElementById('inv-info-coat-total').innerText = formatMoney(r.coatTotal);

            // PHẦN BẾ
            document.getElementById('inv-info-cut-area').innerText = r.totalAreaCm2.toLocaleString('vi-VN', {maximumFractionDigits:2}) + ' cm²';
            document.getElementById('inv-info-cut-shape').innerText = r.shapeName;
            document.getElementById('inv-info-cut-unit').innerText = r.shapeAddCm2 + ' đ/cm²';
            document.getElementById('inv-info-cut-total').innerText = formatMoney(r.cutTotal);

            // TỔNG TIỀN
            document.getElementById('inv-subtotal').innerText = formatMoney(r.subTotal);
            if (r.taxRateValue > 0) {
                document.getElementById('inv-tax-row').style.display = 'flex';
                document.getElementById('inv-tax-label').innerText = `Thuế VAT (${r.taxRateText}):`;
                document.getElementById('inv-tax').innerText = formatMoney(r.taxAmount);
            } else { document.getElementById('inv-tax-row').style.display = 'none'; }
            document.getElementById('inv-total').innerText = formatMoney(r.finalPrice);
            document.getElementById('inv-unit').innerText = formatMoney(r.unitPrice);

            // CLONE ẢNH MÔ PHỎNG
            const originalPreview = document.getElementById('preview-item');
            const cloneContainer = document.getElementById('inv-preview-clone');
            cloneContainer.innerHTML = '';
            const clonedPreview = originalPreview.cloneNode(true);
            clonedPreview.style.width = '100%'; clonedPreview.style.height = '100%';
            clonedPreview.removeAttribute('id');
            clonedPreview.querySelectorAll('*').forEach(el => el.removeAttribute('id'));
            cloneContainer.appendChild(clonedPreview);

            document.getElementById('invoice-modal').classList.remove('hidden');
        }

        function closeInvoiceModal() { document.getElementById('invoice-modal').classList.add('hidden'); }

        function captureInvoice() {
            const captureArea = document.getElementById('invoice-capture-area');
            const btn = document.querySelector('button[onclick="captureInvoice()"]');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i> Đang xử lý...';
            btn.disabled = true;
            
            html2canvas(captureArea, { scale: 2, backgroundColor: '#ffffff', useCORS: true, allowTaint: true }).then(canvas => {
                const link = document.createElement('a');
                link.download = `BaoGia_DecalPro_${new Date().getTime()}.jpg`;
                link.href = canvas.toDataURL('image/jpeg', 0.9);
                link.click();
                btn.innerHTML = originalText; btn.disabled = false;
            }).catch(err => { console.error(err); alert("Lỗi tạo ảnh!"); btn.innerHTML = originalText; btn.disabled = false; });
        }

        function toggleAdminModal() { document.getElementById('admin-modal').classList.toggle('hidden'); }
        function renderAdminInputs() {
            let tSheet = document.getElementById('admin-sheet-pricing');
            let tCm = document.getElementById('admin-cm-pricing');
            tSheet.innerHTML = ''; tCm.innerHTML = '';
            
            for (let key in currentConfig.materials) {
                let mat = currentConfig.materials[key];
                tSheet.innerHTML += `
                    <tr><td class="px-2 py-2 font-medium border-b border-gray-100">${mat.name}</td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_sheet1" value="${mat.sheet_tier1}" class="w-full px-1 border rounded"></td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_sheet2" value="${mat.sheet_tier2}" class="w-full px-1 border rounded"></td>
                        <td class="px-2 py-2 border-b border-gray-100 bg-yellow-50 text-center">${currentConfig.coating.sheet_price}đ</td></tr>
                `;
                tCm.innerHTML += `
                    <tr><td class="px-2 py-2 font-medium border-b border-gray-100">${mat.name}</td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_cm1" value="${mat.cm_tier1}" class="w-full px-1 border rounded"></td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_cm2" value="${mat.cm_tier2}" class="w-full px-1 border rounded"></td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_cm3" value="${mat.cm_tier3}" class="w-full px-1 border rounded"></td>
                        <td class="px-2 py-2 border-b border-gray-100"><input type="number" id="cfg_${key}_cm4" value="${mat.cm_tier4}" class="w-full px-1 border rounded"></td></tr>
                `;
            }
            document.getElementById('cfg-coat-cm1').value = currentConfig.coating.cm_price_normal;
            document.getElementById('cfg-coat-cm2').value = currentConfig.coating.cm_price_bulk;

            let shapesDiv = document.getElementById('admin-shapes');
            shapesDiv.innerHTML = '';
            for (let sKey in currentConfig.shapeSurcharges) {
                let s = currentConfig.shapeSurcharges[sKey];
                shapesDiv.innerHTML += `
                    <div class="flex items-center justify-between p-1 bg-gray-50 border rounded text-xs"><span class="font-medium">${s.name}</span>
                        <div class="flex items-center">+ <input type="number" id="cfg_shape_${sKey}" value="${s.add_cm2}" class="w-10 px-1 py-0.5 text-center border rounded mx-1"> đ</div></div>
                `;
            }
        }

        function saveConfig() {
            for (let key in currentConfig.materials) {
                currentConfig.materials[key].sheet_tier1 = parseInt(document.getElementById(`cfg_${key}_sheet1`).value) || 0;
                currentConfig.materials[key].sheet_tier2 = parseInt(document.getElementById(`cfg_${key}_sheet2`).value) || 0;
                currentConfig.materials[key].cm_tier1 = parseInt(document.getElementById(`cfg_${key}_cm1`).value) || 0;
                currentConfig.materials[key].cm_tier2 = parseInt(document.getElementById(`cfg_${key}_cm2`).value) || 0;
                currentConfig.materials[key].cm_tier3 = parseInt(document.getElementById(`cfg_${key}_cm3`).value) || 0;
                currentConfig.materials[key].cm_tier4 = parseInt(document.getElementById(`cfg_${key}_cm4`).value) || 0;
            }
            for (let sKey in currentConfig.shapeSurcharges) { currentConfig.shapeSurcharges[sKey].add_cm2 = parseFloat(document.getElementById(`cfg_shape_${sKey}`).value) || 0; }
            currentConfig.coating.cm_price_normal = parseFloat(document.getElementById('cfg-coat-cm1').value) || 0;
            currentConfig.coating.cm_price_bulk = parseFloat(document.getElementById('cfg-coat-cm2').value) || 0;

            localStorage.setItem('decalProConfigV11', JSON.stringify(currentConfig));
            alert('Đã lưu cấu hình!'); toggleAdminModal(); calculate();
        }

        function resetDefaultConfig() {
            if(confirm('Khôi phục lại bảng giá gốc?')) {
                currentConfig = JSON.parse(JSON.stringify(DEFAULT_CONFIG));
                localStorage.removeItem('decalProConfigV11');
                renderAdminInputs(); calculate(); alert('Đã khôi phục!');
            }
        }

        window.onload = initApp;
    </script>
</body>
</html>
